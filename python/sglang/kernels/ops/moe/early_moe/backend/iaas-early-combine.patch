+                       convert_to_torch_tensor(l2_weights_sf)),
+        stats, convert_to_torch_tensor(sym_buffer), ptrs,
+        static_cast<int>(rank), static_cast<int>(capacity),
+        static_cast<int>(num_experts), static_cast<int>(num_topk),
+        std::make_tuple(static_cast<int>(rm), static_cast<int>(rn), static_cast<int>(rk)),
+        activation, clamp_value, fast_math,
+        convert_to_torch_tensor(early_values), convert_to_torch_tensor(early_done));
 }
 
