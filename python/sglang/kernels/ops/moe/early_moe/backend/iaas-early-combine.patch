+// Separate FFI entry keeps the existing fp8_mega_moe ABI unchanged.
+void iaas_fp8_mega_moe_with_early(
+    TensorView y, TensorView l1_weights, TensorView l1_weights_sf,
+    TensorView l2_weights, TensorView l2_weights_sf,
+    Optional<TensorView> recv_stats, TensorView sym_buffer,
+    Array<int64_t> buffer_ptrs, int64_t rank, int64_t capacity,
+    int64_t num_experts, int64_t num_topk,
+    Tuple<int64_t, int64_t, int64_t> recipe, std::string activation,
+    Optional<double> clamp, bool fast_math,
+    TensorView early_values, TensorView early_done) {
+    const auto stats = recv_stats.has_value()
+        ? std::optional<torch::Tensor>(convert_to_torch_tensor(recv_stats.value()))
+        : std::nullopt;
+    const auto clamp_value = clamp.has_value()
+        ? std::optional<float>(static_cast<float>(clamp.value())) : std::nullopt;
+    std::vector<int64_t> ptrs;
+    for (const auto ptr : buffer_ptrs)
+        ptrs.push_back(ptr);
+    const auto [rm, rn, rk] = recipe;
+    mega::fp8_mega_moe(
+        convert_to_torch_tensor(y),
+        std::make_pair(convert_to_torch_tensor(l1_weights),
