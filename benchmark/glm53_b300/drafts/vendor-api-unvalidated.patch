+class TestVendorThinking(unittest.TestCase):
+    def request(self, **kwargs):
+        return ChatCompletionRequest(model="x", messages=[{"role": "user", "content": "hi"}], **kwargs)
+
+    def test_switch_and_sampling_preserved(self):
+        for mode, enabled in (("enabled", True), ("disabled", False)):
+            request = self.request(thinking={"type": mode}, temperature=0.7, top_p=0.9, max_tokens=37)
+            self.assertEqual(request.chat_template_kwargs["enable_thinking"], enabled)
+            self.assertEqual((request.temperature, request.top_p, request.max_tokens), (0.7, 0.9, 37))
+
+    def test_invalid_and_conflicting_fields(self):
+        for fields in (
+            {"thinking": {"type": "auto"}},
+            {"thinking": {"type": "enabled", "unknown": 1}},
+            {"thinking": {"type": "enabled"}, "reasoning_effort": "none"},
+            {"thinking": {"type": "disabled"}, "reasoning_effort": "high"},
+            {"thinking": {"type": "disabled"}, "chat_template_kwargs": {"enable_thinking": True}},
+        ):
+            with self.subTest(fields=fields), self.assertRaises(ValidationError):
+                self.request(**fields)
+
+    def test_existing_template_override_precedence_unchanged(self):
+        request = self.request(reasoning_effort="high", chat_template_kwargs={"enable_thinking": False})
+        self.assertFalse(request.chat_template_kwargs["enable_thinking"])
+
+    def test_cache_counts_streaming_and_nonstreaming(self):
+        from sglang.srt.entrypoints.openai.usage_processor import UsageProcessor
+        for enabled in (False, True):
+            for count in (0, 8):
+                response = UsageProcessor.calculate_response_usage(
+                    [{"meta_info": {"prompt_tokens": 10, "completion_tokens": 2, "cached_tokens": count}}],
+                    enable_cache_report=enabled,
+                )
+                stream = UsageProcessor.calculate_streaming_usage(
+                    {0: 10}, {0: 0}, {0: 2}, {0: count}, 1, enable_cache_report=enabled,
+                )
+                for usage in (response, stream):
+                    data = usage.model_dump()
+                    if enabled:
+                        self.assertEqual(data["cached_tokens"], count)
+                        self.assertEqual(data["prompt_tokens_details"]["cached_tokens"], count)
+                    else:
+                        self.assertNotIn("cached_tokens", data)
+                    self.assertEqual(data["total_tokens"], 12)
+
+
