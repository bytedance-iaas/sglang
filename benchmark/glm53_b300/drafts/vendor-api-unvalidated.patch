+    def _adapt_glm53_generation_prefix(
+        self, prompt: str, request: ChatCompletionRequest
+    ) -> str:
+        """Close GLM-5.3's reasoning prefix before generation when disabled.
+
+        This changes model input, never hides generated reasoning. The template
+        signature and exact suffix guard prevent rewriting unrelated templates
+        or markers inside conversation history.
+        """
+        config = self.template_manager.reasoning_config
+        if (
+            config is None
+            or config.special_case != "glm53_generation_prefix"
+            or self._get_reasoning_from_request(request)
+        ):
+            return prompt
+        if not isinstance(prompt, str) or not prompt.endswith("<think>"):
+            raise ValueError("GLM-5.3 thinking.disabled requires an opening generation prefix")
+        return prompt[:-len("<think>")] + "</think>"
+
