ARG BASE_IMAGE=ai-containers-cn-beijing.cr.volces.com/deeplearning/sglang:v0.5.15.post1.iaas.dev.202607201127@sha256:a322afaa9aa032810aa559d2497ed57fe91b71ac6d470c8b843923fadf7075d3
FROM ${BASE_IMAGE}

ARG SGLANG_SOURCE_COMMIT
ARG SGLANG_SOURCE_TREE
ARG SGLANG_SOURCE_PYTHON_SHA256
ARG SGLANG_BUILD_URL
ARG SGLANG_BASE_IMAGE

LABEL org.opencontainers.image.source="https://github.com/bytedance-iaas/sglang" \
      org.opencontainers.image.revision="${SGLANG_SOURCE_COMMIT}" \
      org.opencontainers.image.url="${SGLANG_BUILD_URL}" \
      ai.sglang.build.commit="${SGLANG_SOURCE_COMMIT}" \
      ai.sglang.build.tree="${SGLANG_SOURCE_TREE}" \
      ai.sglang.build.python-manifest-sha256="${SGLANG_SOURCE_PYTHON_SHA256}" \
      ai.sglang.build.url="${SGLANG_BUILD_URL}" \
      ai.sglang.build.base-image="${SGLANG_BASE_IMAGE}" \
      ai.sglang.source.delivery="image-baked-no-runtime-install"

# Preserve the measured H20 binary stack. The live benchmark used a sparse
# checkout containing only python/ and installed sglang-kernel 0.4.5 at Pod
# startup. Bake that exact tested kernel into the image while leaving PyTorch,
# FlashInfer, DeepEP, DeepGEMM, Mooncake, and EIC unchanged.
RUN HTTP_PROXY="" HTTPS_PROXY="" http_proxy="" https_proxy="" \
    python3 -m pip install \
      sglang-kernel==0.4.5 \
      --force-reinstall \
      --no-deps \
      --break-system-packages \
      --timeout 600 \
      --retries 5

RUN rm -rf /sgl-workspace/sglang/python
COPY python /sgl-workspace/sglang/python
COPY .glm52-build/tracked-python.manifest /usr/local/share/sglang/tracked-python.manifest

RUN set -euo pipefail; \
    test -n "${SGLANG_SOURCE_COMMIT}"; \
    test -n "${SGLANG_SOURCE_TREE}"; \
    test -n "${SGLANG_SOURCE_PYTHON_SHA256}"; \
    printf '%s  %s\n' \
      "${SGLANG_SOURCE_PYTHON_SHA256}" \
      /usr/local/share/sglang/tracked-python.manifest \
      | sha256sum --check --status; \
    cd /sgl-workspace/sglang; \
    sha256sum --check --status /usr/local/share/sglang/tracked-python.manifest; \
    find python -type d -name __pycache__ -prune -exec rm -rf '{}' +; \
    printf 'commit=%s\ntree=%s\ntracked_python_sha256=%s\nbase_image=%s\nbuild_url=%s\n' \
      "${SGLANG_SOURCE_COMMIT}" \
      "${SGLANG_SOURCE_TREE}" \
      "${SGLANG_SOURCE_PYTHON_SHA256}" \
      "${SGLANG_BASE_IMAGE}" \
      "${SGLANG_BUILD_URL}" \
      > /usr/local/share/sglang/source-provenance.env; \
    cd /tmp; \
    python3 -c 'import pathlib, sglang; expected = pathlib.Path("/sgl-workspace/sglang/python/sglang/__init__.py"); actual = pathlib.Path(sglang.__file__).resolve(); print(f"SGLANG_IMAGE_IMPORT_FILE={actual}"); assert actual == expected'

ENV SGLANG_BUILD_COMMIT=${SGLANG_SOURCE_COMMIT} \
    SGLANG_BUILD_URL=${SGLANG_BUILD_URL} \
    SGLANG_BUILD_TREE=${SGLANG_SOURCE_TREE} \
    SGLANG_PYTHON_MANIFEST_SHA256=${SGLANG_SOURCE_PYTHON_SHA256}

WORKDIR /sgl-workspace/sglang
