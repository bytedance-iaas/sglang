# Source in every RDMA worker before starting Python (FP4 or FP8).
# The filename is retained for existing launch scripts. NIC/GID/TC/interface
# mapping and NVSHMEM_IBGDA_NUM_RC_PER_PE (>= experts/EP + 1) are deployment settings.
# FP4 defaults to GENERAL=1 and LTO=1; the wheel supplies its LTO tools.
# For FP4 requested capacity >1024, explicitly set IAAS_KERNELS_RDMA_RS_GENERAL=0.
# FP8 selects its own policy and ignores the FP4 overrides.
export NVSHMEM_IB_ENABLE_IBGDA=1
export NVSHMEM_IB_ENABLE_RELAXED_ORDERING=0
