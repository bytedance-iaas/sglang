# Source in every FP4 RDMA worker before starting Python. NIC/GID/TC/interface
# mapping and NVSHMEM_IBGDA_NUM_RC_PER_PE (>= experts/EP + 1) are deployment settings.
# Do not source this FP4 profile for FP8: FP8 requires RS_GENERAL=0.
export NVSHMEM_IB_ENABLE_IBGDA=1
export NVSHMEM_IB_ENABLE_RELAXED_ORDERING=0
export IAAS_KERNELS_RDMA_RS_GENERAL=1
export IAAS_KERNELS_RDMA_MEGA_MOE_FP4_RS_LTO=1
export IAAS_KERNELS_RDMA_JIT_NVSHMEM_LTO_LINKER=/opt/sglang/share/iaas-kernels/lto/link_object
export IAAS_KERNELS_RDMA_JIT_NVSHMEM_LTO_ARCHIVE=/opt/sglang/share/iaas-kernels/lto/libnvshmem_device_lto.a
