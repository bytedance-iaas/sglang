+        import socket
+
+        # gethostbyname can resolve to 127.0.0.1 on some hosts, colliding keys
+        # across nodes; prefer the pod-provided MY_HOST_IP.
+        return os.environ.get("MY_HOST_IP") or socket.gethostbyname(
