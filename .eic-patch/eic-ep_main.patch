+                # not req_to_token (which stays 0 for the loaded portion). Use
+                # prefix_indices for the in-prefix slice so the in-window SWA is
+                # actually freed; req_to_token would map to 0 and be dropped.
+                if _swa_hi <= _prefix_len:
